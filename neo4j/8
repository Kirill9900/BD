MATCH (d:Driver)<-[:PERFORMED_BY]-(t:Trip)-[:FOLLOWS]->(r:Route)
WHERE t.status IN ['Завершена', 'В пути']
  AND t.startTime >= datetime('2024-12-01T00:00:00Z')
WITH d, 
     count(DISTINCT t) as completedTrips,
     sum(r.distanceKm) as totalDistance,
     avg(r.distanceKm) as avgDistance,
     collect(DISTINCT r.name) as routes

OPTIONAL MATCH (d)-[:DRIVES]->(v:Vehicle)-[:SERVICED]->(m:Maintenance)
WHERE m.isCompleted = true
WITH d, completedTrips, totalDistance, avgDistance, routes,
     sum(m.costRub) as maintenanceCost,
     count(DISTINCT v) as vehiclesUsed

WHERE completedTrips > 0

RETURN d.firstName + ' ' + d.lastName as Driver,
       d.experienceYears,
       completedTrips,
       vehiclesUsed,
       totalDistance,
       round(avgDistance) as avgTripDistance,
       maintenanceCost,
       CASE 
         WHEN maintenanceCost IS NOT NULL AND totalDistance > 0 
         THEN round(maintenanceCost / totalDistance, 2)
         ELSE 0 
       END as costPerKm,
       size(routes) as uniqueRoutes,
       routes[0..3] as sampleRoutes

ORDER BY completedTrips DESC, totalDistance DESC
LIMIT 15;






















